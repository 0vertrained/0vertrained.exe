# 0VERTRAINED environment variables (v19.x).
# Copy to .env for local development. In production, set these in Netlify
# (Site settings → Environment variables). See README → "Environment variables".
#
# VITE_* values are baked into the browser bundle at build time and are PUBLIC.
# Never put a secret behind a VITE_ prefix.

# ─── Client (browser, public) ────────────────────────────────────────────────
# Required unless VITE_DEMO_MODE=true.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "true" builds the no-backend demo (mock Supabase client, seeded data).
VITE_DEMO_MODE=
# Domain for synthetic login emails (username@domain). Default: athlete.app.
# Only change together with scripts/migrate-auth-domain.mjs (see README).
VITE_AUTH_EMAIL_DOMAIN=
# Optional integrations.
VITE_USDA_API_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_COACH_USER_ID=
VITE_COACH_OPEN=

# ─── Server (Netlify Functions, secret) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for wearable OAuth tokens (openssl rand -base64 32).
# Must be set before anyone connects a wearable; losing it forces reconnects.
TOKEN_ENCRYPTION_KEY=
# Legacy alias for TOKEN_ENCRYPTION_KEY.
CONNECTED_ACCOUNT_ENCRYPTION_KEY=

# Oura
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
OURA_SYNC_SECRET=

# Whoop
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Optional: reject webhook events for any other subscription id.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Google Health / Fitbit (integration is disabled in the UI).
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=
GOOGLE_HEALTH_WEBHOOK_SECRET=

# Web Push (npx web-push generate-vapid-keys). VITE_VAPID_PUBLIC_KEY = VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AI coach (Ollama Cloud)
OLLAMA_API_KEY=
COACH_ALLOWED_USER_ID=
COACH_ENABLED=
COACH_DAILY_LIMIT=
COACH_EXPOSE_MODEL=
COACH_ROUTING_MODE=
COACH_MODEL=
COACH_FAST_MODEL=
COACH_MAIN_MODEL=
COACH_DEEP_MODEL=
COACH_FALLBACK_MODEL=
COACH_FAST_TIMEOUT_MS=
COACH_MAIN_TIMEOUT_MS=
COACH_DEEP_TIMEOUT_MS=
COACH_FALLBACK_TIMEOUT_MS=

# Form check proxy → external pose engine (not in this repo).
FORM_CHECK_API_BASE=
FORM_CHECK_API_KEY=
FORM_CHECK_MAX_BYTES=

# Telemetry caps (per user per day).
LOG_ERROR_DAILY_CAP=
LOG_EVENT_DAILY_CAP=
